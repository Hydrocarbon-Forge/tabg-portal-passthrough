<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx packages (BepInEx.Core, BepInEx.Harmony, BepInEx.PluginInfoProps) are
  published on the BepInEx NuGet feed, NOT nuget.org. HarmonyX is on nuget.org.
  Keep both feeds so the csproj resolves on any box.
-->
<configuration>
  <packageSources>
    <add key="local" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepis.dev/v3/index.json" />
  </packageSources>
</configuration>

