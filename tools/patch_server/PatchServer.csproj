<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local-only TABG dedicated-server patcher (see README.md next to this file).
       Runs on Linux or Windows against the Windows server's managed DLL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PatchServer</AssemblyName>
    <RootNamespace>PatchServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
